<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Register validators here: add or remove an <item> to enable/disable a rule -->
    <type name="Delgraf\ItalianValidation\Model\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="codice_fiscale" xsi:type="object">Delgraf\ItalianValidation\Model\Validator\CodiceFiscale</item>
                <item name="codice_fiscale_numerico" xsi:type="object">Delgraf\ItalianValidation\Model\Validator\CodiceFiscaleNumerico</item>
                <item name="partita_iva" xsi:type="object">Delgraf\ItalianValidation\Model\Validator\PartitaIva</item>
                <item name="recapito_fattura_elettronica" xsi:type="object">Delgraf\ItalianValidation\Model\Validator\RecapitoFatturaElettronica</item>
            </argument>
        </arguments>
    </type>

    <!-- Inject our rules into Amasty without touching its files -->
    <type name="Amasty\CustomerAttributes\Model\Validation">
        <plugin name="Delgraf_ItalianValidation::add_italian_validations"
                type="Delgraf\ItalianValidation\Plugin\Amasty\CustomerAttributes\ValidationPlugin"/>
    </type>
</config>
